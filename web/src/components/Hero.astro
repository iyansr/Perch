---
import { AppleLogoIcon, ArrowRightIcon } from '@phosphor-icons/react/ssr';
import NotchDemo from './demo/NotchDemo';
import { SITE } from '../site';
---

<section id="top" class="mx-auto max-w-6xl px-5 pt-14 sm:pt-20">
	<div class="max-w-3xl mx-auto text-center">
		<h1 class="display text-[44px] sm:text-[64px] lg:text-[76px]">Your notch,<br />put to work.</h1>
		<p class="mt-5 max-w-[52ch] text-[17px] leading-relaxed text-fg-2 sm:text-[19px]">
			Search, clipboard history, file conversion and live status for your coding agents, in the one spot windows never
			cover.
		</p>
		<div class="mt-8 flex flex-wrap items-center gap-3 mx-auto justify-center">
			<a
				href={SITE.downloadUrl}
				class="press inline-flex h-12 items-center gap-2 rounded-full bg-accent px-6 text-[16px] font-semibold text-accent-ink hover:bg-[#ffad2e]"
			>
				<AppleLogoIcon size={18} weight="fill" aria-hidden="true" />
				Download for Mac
			</a>
			<a
				href="#agents"
				class="press inline-flex h-12 items-center gap-2 rounded-full border border-line-strong px-5 text-[16px] font-medium text-fg hover:bg-white/[0.05]"
			>
				How agents connect
				<ArrowRightIcon size={16} weight="bold" aria-hidden="true" />
			</a>
		</div>
	</div>

	<div id="demo" class="mt-12 scroll-mt-24 sm:mt-16">
		<NotchDemo client:visible />
	</div>
</section>
